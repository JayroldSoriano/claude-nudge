{
  "name": "nudge-mascot",
  "version": "1.0.0",
  "description": "Nudge: a pixel mascot waves in Chrome when Claude Code has a question, needs permission, or is done.",
  "scripts": {
    "start": "node relay/server.js",
    "test": "node relay/adapters/test.js",
    "setup": "node bin/nudge.js setup",
    "status": "node bin/nudge.js status",
    "test-nudge": "node bin/nudge.js test",
    "icons": "node scripts/make-icons.js",
    "assets": "node scripts/make-assets.js",
    "pack": "sh scripts/pack-extension.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayroldSoriano/nudge-mascot.git"
  },
  "homepage": "https://nudge-mascot.vercel.app/",
  "keywords": [
    "claude",
    "claude-code",
    "chrome-extension",
    "notifications",
    "hooks",
    "agent"
  ],
  "bin": {
    "nudge-mascot": "bin/nudge.js"
  },
  "files": [
    "bin",
    "relay/server.js",
    "relay/pairing.js",
    "relay/focus.js",
    "relay/stats.js",
    "relay/secret.js",
    "relay/adapters/index.js",
    "relay/adapters/claude-code.js",
    "relay/adapters/codex.js",
    "relay/adapters/gemini.js",
    "relay/package.json",
    "hooks/nudge-hook.sh",
    "hooks/nudge-approve.js",
    "extension",
    "README.md",
    "LICENSE"
  ]
}
