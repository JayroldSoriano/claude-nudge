{
  "name": "nudge-for-claude-code",
  "version": "0.2.0",
  "private": true,
  "description": "Nudge for Claude Code: a pixel mascot waves in Chrome when Claude Code has a question, needs permission, or is done.",
  "scripts": {
    "start": "node relay/server.js",
    "setup": "node bin/claude-nudge.js setup",
    "status": "node bin/claude-nudge.js status",
    "test-nudge": "node bin/claude-nudge.js test",
    "icons": "node scripts/make-icons.js",
    "assets": "node scripts/make-assets.js",
    "pack": "sh scripts/pack-extension.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayroldSoriano/claude-nudge.git"
  },
  "homepage": "https://jayroldsoriano.github.io/claude-nudge/",
  "keywords": [
    "claude",
    "claude-code",
    "chrome-extension",
    "notifications",
    "hooks",
    "agent"
  ],
  "bin": {
    "nudge-for-claude-code": "bin/claude-nudge.js"
  },
  "files": [
    "bin",
    "relay",
    "hooks",
    "extension",
    "README.md",
    "LICENSE"
  ]
}
